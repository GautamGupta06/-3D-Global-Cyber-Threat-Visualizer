# ─── 3D Cyber Threat SOC Visualizer Environment Config ───

# Backend Configuration
PORT=4000
NODE_ENV=production

# WebSocket Token Authentication (Optional - leave blank for open access)
AUTH_TOKEN=

# Slack, Discord, or Generic Alert Webhook URL (Dispatches on CRITICAL threats)
WEBHOOK_URL=

# ML Service Ingestion URL
BACKEND_API=http://backend:4000/api/threats

# Frontend Target Backend Endpoint
VITE_BACKEND_URL=http://localhost:4000
